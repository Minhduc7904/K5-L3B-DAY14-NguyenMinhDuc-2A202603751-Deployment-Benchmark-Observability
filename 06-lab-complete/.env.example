# ============================================================
# Biến môi trường của agent — chỉ ghi GIÁ TRỊ MẪU, không ghi secret thật.
# Dùng:  cp .env.example .env   (file .env đã nằm trong .gitignore)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development

# Bảo mật: client gửi header X-API-Key trùng giá trị này.
# Tạo key thật bằng:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me-to-a-long-random-string

# Redis dùng chung cho rate limiter và cost guard
# (trong docker compose, REDIS_URL được ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa mỗi API key trong cửa sổ trượt 60 giây
RATE_LIMIT_PER_MINUTE=10

# Cost guard: ngân sách LLM tối đa mỗi API key mỗi ngày (USD, tính theo UTC)
DAILY_BUDGET_USD=1.0
